# Backend API Base URL (FastAPI via ngrok tunnel for production or http://localhost:8000 for local dev)
NEXT_PUBLIC_API_URL=https://snowiness-reformer-copied.ngrok-free.dev

# Frontend Base URL
NEXTAUTH_URL=https://hrhiringloop.vercel.app

# NextAuth Secret (placeholder - generate with `openssl rand -base64 32`)
NEXTAUTH_SECRET=your_nextauth_secret_here

# Google OAuth Client ID (matching Google Cloud Console)
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
